# Application Environment: 'production' or 'development' (can also use ENVIRONMENT or ENV)
APP_ENV=development

# Database Connection (Supabase PostgreSQL / AWS pooler)
DATABASE_URL=postgres://localhost/abhishare_dev
PORT=8080

# CORS Allowed Origins (Comma-separated origins for production web frontends)
# e.g., https://abhishare.netlify.app,https://admin.abhishare.com
ALLOWED_ORIGINS=https://abhishare.netlify.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=abhishare16@gmail.com

# Storage Configuration
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_BUCKET_PUBLIC=abhishare-public
SUPABASE_BUCKET_PRIVATE=abhishare-private

# Razorpay Configuration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Extra Pay Configuration (AbhiShare platform fee percentage added to ride creator price)
EXTRA_PAY_PERCENT=4

GEOAPIFY_API_KEY=YOUR_REPLACEMENT_API_KEY